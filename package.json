{
  "name": "nerve",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source visual command center for OpenClaw and Hermes agent fleets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyeesu/nerve.git"
  },
  "homepage": "https://github.com/boyeesu/nerve#readme",
  "bugs": {
    "url": "https://github.com/boyeesu/nerve/issues"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "keywords": [
    "agent-orchestration",
    "ai-agents",
    "openclaw",
    "hermes",
    "command-center"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:next": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "build:sites": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "node .next/standalone/server.js",
    "start:standalone": "node server.js",
    "start:railway": "npm run db:migrate && npm run start:standalone",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "8.9.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.50.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-rsc": "0.5.32",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.0",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vinext": "0.2.1",
    "vite": "8.2.0",
    "wrangler": "4.118.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260730.1": true
  }
}
