# Required: Railway Postgres connection string.
DATABASE_URL=postgresql://postgres:password@host:5432/railway

# Required: generate each value independently. Never commit real values.
# openssl rand -base64 32
NERVE_ENCRYPTION_KEY=
# openssl rand -base64 48
NERVE_SESSION_SECRET=
# openssl rand -base64 32
NERVE_ADMIN_TOKEN=

# Optional: use independently rotatable role-scoped keys instead of sharing the
# legacy admin token. JSON array entries support viewer, operator, or admin.
# NERVE_ACCESS_KEYS=[{"actor":"alice","role":"admin","token":"replace-me"},{"actor":"observer","role":"viewer","token":"replace-me"}]
# Each key may include "workspaceId":"research". Omitted means "default".
# Different workspaces cannot read or mutate each other's Nerve records.
# Use different runtime credentials/endpoints for mutually untrusted teams.

# Exact public origin (no trailing slash). Use the real HTTPS origin in production.
# A mismatched origin blocks browser sign-in and mutations.
NERVE_PUBLIC_URL=http://localhost:3000

# Keep false for public deployments. Enable only when Nerve runs on a trusted
# private network and must reach RFC1918/localhost agent runtimes.
NERVE_ALLOW_PRIVATE_NETWORKS=false

# Durable command delivery + audit/session housekeeping (long-lived Node only).
# Defaults to true. Do not enable on suspended/serverless instances.
# Disabling rejects mission launches and asynchronous delivery.
NERVE_WORKER_ENABLED=true

# Leave empty unless your trusted reverse proxy OVERWRITES this header.
# Allowed: cf-connecting-ip, x-real-ip, x-forwarded-for.
# Otherwise all logins share an atomic 8-attempt / 15-minute ingress bucket.
NERVE_TRUSTED_IP_HEADER=

# Railway injects PORT. Set only for non-Railway hosting.
PORT=3000
