{
  "name": "nerve",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Open-source visual command center for OpenClaw and Hermes agent fleets.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boyeesu/nerve.git"
  },
  "homepage": "https://github.com/boyeesu/nerve#readme",
  "bugs": {
    "url": "https://github.com/boyeesu/nerve/issues"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.26",
      "sharp": "0.35.4"
    },
    "baseline-browser-mapping": "2.11.26"
  },
  "keywords": [
    "agent-orchestration",
    "ai-agents",
    "openclaw",
    "hermes",
    "command-center"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:next": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "start:standalone": "node server.js",
    "start:railway": "npm run db:migrate && npm run start:standalone",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "undici": "8.11.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.11.1": true
  }
}
